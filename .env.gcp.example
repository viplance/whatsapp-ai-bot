# CONTROL_DATABASE=whatsapp-control
# RUNTIME_DATABASE=whatsapp-runtime
# CONFIG_ID=whatsapp-main
# SUMMARY_JOB=whatsapp-summary
# PAIRING_JOB=whatsapp-pairing
# SCHEDULER_JOB=whatsapp-summary
# GEMINI_SECRET=whatsapp-gemini-api-key
