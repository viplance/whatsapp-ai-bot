# Copy to .env.gcp and fill in your deployment parameters.
# Load with: pnpm deploy:gcp
GOOGLE_CLOUD_PROJECT=your-gcp-project
GCP_REGION=europe-west4
ADMIN_EMAIL=you@example.com

